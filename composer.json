{
  "name": "ddrv/env",
  "type": "library",
  "description": "Read variables from environment or .env file",
  "keywords": ["env", ".env", "environment"],
  "license": "MIT",
  "authors": [
    {
      "name": "Ivan Dudarev",
      "email": "ivan@ddrv.ru"
    }
  ],
  "require": {
    "php": "^8.1"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^10.5 || ^11.5 || ^12.1",
    "squizlabs/php_codesniffer": "^3.7"
  },
  "autoload": {
    "psr-4": {
      "Ddrv\\Env\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\Code\\Ddrv\\Env\\": "tests/src/",
      "Tests\\Unit\\Ddrv\\Env\\": "tests/unit/"
    }
  },
  "funding": [
    {
      "type": "other",
      "url": "https://donation.ddrv.ru/"
    }
  ]
}
